{
  "name": "deuce-card-room",
  "version": "1.0.0",
  "private": true,
  "description": "Blackjack, Texas Hold'em and Craps as an installable web app.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build:www": "node scripts/build-www.mjs",
    "ios": "npm run build:www && npx cap sync ios && npx cap open ios",
    "ios:icons": "npx @capacitor/assets generate --ios --iconBackgroundColor '#2a0a17' --splashBackgroundColor '#2a0a17'"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.110.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
